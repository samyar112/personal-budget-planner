{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vaultBudget;Username=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_openssl_rand_-base64_48_OUTPUT",
    "Issuer": "VaultBudget",
    "Audience": "VaultBudget",
    "ExpiresMinutes": 60,
    "RefreshExpiresDays": 7,
    "RefreshGraceSeconds": 20
  },
  "AuthSecurity": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "YOUR_ADDRESS@gmail.com",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "YOUR_ADDRESS@gmail.com",
      "Password": "GMAIL_APP_PASSWORD"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}
