{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vaultBudget;Username=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_openssl_rand_-base64_48_OUTPUT",
    "Issuer": "VaultBudget",
    "Audience": "VaultBudget",
    "ExpiresMinutes": 15,
    "RefreshExpiresDays": 7,
    "RefreshGraceSeconds": 20,
    "IdleTimeoutMinutes": 15
  },
  "AuthSecurity": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "ResendPermitLimit": 3,
    "ResendWindowSeconds": 300
  },
  "Email": {
    "Provider": "Smtp",
    "FrontendBaseUrl": "http://localhost:5173",
    "FromAddress": "YOUR_ADDRESS@gmail.com",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "YOUR_ADDRESS@gmail.com",
      "Password": "GMAIL_APP_PASSWORD",
      "CheckCertificateRevocation": true
    }
  },
  "Google": {
    "ClientId": "SAME_VALUE_AS_VITE_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
  },
  "Plaid": {
    "ClientId": "PLAID_CLIENT_ID_FROM_DASHBOARD",
    "Secret": "PLAID_SANDBOX_SECRET_FROM_DASHBOARD",
    "Environment": "sandbox",
    "TokenEncryptionKey": "REPLACE_WITH_openssl_rand_-base64_32_OUTPUT"
  },
  "AiAdvisor": {
    "ApiKey": "OPENROUTER_KEY_FROM_openrouter.ai/keys_OR_EMPTY_FOR_TEMPLATE_TIPS"
  },
  "Stripe": {
    "SecretKey": "sk_test_FROM_STRIPE_DASHBOARD_OR_EMPTY_TO_DISABLE_PAYMENTS",
    "WebhookSecret": "whsec_PRINTED_BY_stripe_listen",
    "PriceId": "price_OF_THE_2.99_MONTHLY_PRICE",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}
