{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "VaultBudget",
    "Audience": "VaultBudget",
    "ExpiresMinutes": 15,
    "RefreshExpiresDays": 7,
    "RefreshGraceSeconds": 20
  },
  "AuthSecurity": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "ResendPermitLimit": 3,
    "ResendWindowSeconds": 300
  },
  "Email": {
    "Provider": "File",
    "FrontendBaseUrl": "http://localhost:5173",
    "VerificationTokenMinutes": 15,
    "FromAddress": "no-reply@vaultbudget.local",
    "OutputDirectory": "email-outbox",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}
