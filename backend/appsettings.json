{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "VaultBudget",
    "Audience": "VaultBudget",
    "ExpiresMinutes": 15,
    "RefreshExpiresDays": 7,
    "RefreshGraceSeconds": 20
  },
  "AuthSecurity": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  }
}
